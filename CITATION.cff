# Citation metadata for this repository (Citation File Format 1.2.0).
# Spec: https://citation-file-format.github.io/
# Validate with: pipx run cffconvert --validate
#
# The paper's facts here mirror CITATION.bib, which is the source the README quotes and
# the docs include. src/tests/test_citation_metadata.py fails if the two drift apart.

cff-version: 1.2.0
message: "If you use this benchmark, please cite it as below."
title: "IBL BrainWideBench"
abstract: >-
  A benchmark for large-scale pretraining and across-animal transfer on multi-region
  Neuropixels recordings from the International Brain Laboratory. Models pretrain on 423
  sessions and transfer to 29 held-out sessions across three task suites: decoding
  behavior and stimulus, predicting neural activity, and decoding brain region from unit
  activity.
type: software
license: MIT  # SPDX identifier, matches the LICENSE file
repository-code: "https://github.com/brainbench-org/ibl-bwb"
url: "https://arxiv.org/abs/2609.22064"
version: "0.1.0"  # keep in sync with pyproject.toml
# date-released belongs to a tagged release of the software, so it is added with the
# first one rather than carried as a placeholder that fails validation.
keywords:
  - neuroscience
  - benchmark
  - electrophysiology
  - neural-decoding
  - brain-wide-map

# The paper's author list, in the paper's order. "International Brain Laboratory" is a
# consortium rather than a person, so it is an entity entry.
